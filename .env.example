# Gaia Fiscal Intelligence - example environment configuration
# Copy to .env for local development only. Never commit real credentials.

# ======================================================================
# APPLICATION
# ======================================================================
API_ENVIRONMENT="development"
API_HOST="0.0.0.0"
API_PORT="8000"
API_CORS_ORIGINS="http://localhost:3000"
CUSTOMER_APP_URL="http://localhost:3000"

# ======================================================================
# DATABASE
# ======================================================================
# Use a dedicated application role. Do not paste production credentials here.
DATABASE_URL="postgresql+psycopg://gaiafaac:change-me@localhost:5432/gaiafaac"

# ======================================================================
# CUSTOMER / ADMIN SECURITY
# ======================================================================
ADMIN_KEY=""
REVIEW_BASIC_AUTH=""
CUSTOMER_ALERT_EMAIL_ENABLED="false"
INSTITUTIONAL_WEBHOOK_ENABLED="false"
INSTITUTIONAL_WEBHOOK_MASTER_SECRET=""

# ======================================================================
# SMTP / CUSTOMER COMMUNICATIONS
# ======================================================================
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USERNAME=""
SMTP_PASSWORD=""
ALERT_FROM=""
ALERT_TO=""
ZOHO_SENDER_EMAIL=""
ZOHO_SENDER_PASSWORD=""

# ======================================================================
# PAYSTACK - PAYMENT PROCESSING
# ======================================================================
# Use test keys in non-production environments and live keys only after launch review.
PAYSTACK_PUBLIC_KEY="pk_test_xxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxx"
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_SANDBOX_MODE="true"
PAYSTACK_PRICE_ANALYST="50000"
PAYSTACK_PRICE_TEAM="200000"
PAYSTACK_PRICE_API="300000"

# One-time products remain checkout-disabled while these are zero. Set only after
# an approved commercial price is chosen; values are whole Naira, never kobo.
PAYSTACK_PRICE_DECISION_PACK="0"
PAYSTACK_PRICE_MULTI_STATE_COMPARISON_PACK="0"
PAYSTACK_PRICE_HISTORICAL_EVIDENCE_EXPORT="0"
PAYSTACK_PRICE_DUE_DILIGENCE_SNAPSHOT="0"

# ======================================================================
# OPTIONAL STRIPE FALLBACK
# ======================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ANALYST=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_API=""

# ======================================================================
# SOURCE ARCHIVE - S3 COMPATIBLE OBJECT STORAGE
# ======================================================================
SOURCE_ARCHIVE_BUCKET=""
SOURCE_ARCHIVE_ENDPOINT=""
SOURCE_ARCHIVE_ACCESS_KEY_ID=""
SOURCE_ARCHIVE_SECRET_ACCESS_KEY=""
SOURCE_ARCHIVE_REGION="auto"