POSTGRES_DB=gaiafaac
POSTGRES_USER=gaiafaac
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://gaiafaac:change-me@db:5432/gaiafaac

API_HOST=0.0.0.0
API_PORT=8000
API_ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000

# Browser-safe public API fallback for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side web -> FastAPI URL. In Railway prefer the private service domain.
API_INTERNAL_URL=http://localhost:8000

# Operational secrets. Generate unique high-entropy values; never commit real secrets.
ADMIN_KEY=replace-with-random-admin-key
REVIEW_BASIC_AUTH=admin:replace-with-strong-password
REVIEWER_ID=00000000-0000-0000-0000-000000000000

# Optional collection/review and customer invitation email configuration.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# Customer self-service application URL used for redirects, invitation links, and alert links.
CUSTOMER_APP_URL=http://localhost:3000

# Outbound Watchlist email is double-gated: the customer must opt in and this operator gate
# must be true. Keep false until SMTP and production delivery operations are intentionally ready.
CUSTOMER_ALERT_EMAIL_ENABLED=false

# Institutional webhook delivery is independently disabled by default. The master secret is
# operator key material used to derive endpoint signing secrets; plaintext endpoint secrets are
# never stored. Use a unique high-entropy production value and keep it stable after activation.
INSTITUTIONAL_WEBHOOK_ENABLED=false
INSTITUTIONAL_WEBHOOK_MASTER_SECRET=

# Stripe Billing. Leave blank to keep checkout and billing management disabled.
# Configure recurring monthly Prices in Stripe for the existing $49/$199/$299 plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANALYST=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_API=
